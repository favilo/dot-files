#!/usr/bin/env bash
set -e

detect_os() {
  if [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    echo "$ID"
  else
    uname -s | tr '[:upper:]' '[:lower:]'
  fi
}

install_prereqs() {
  local os="$1"
  local pkgs=(ansible just git curl selene lua-language-server uv prek)

  # Check if all packages are already installed
  local install_needed=false
  for pkg in "${pkgs[@]}"; do
    if ! command -v "$pkg" &>/dev/null; then
      install_needed=true
      break
    fi
  done

  if [ "$install_needed" = false ]; then
    return 0
  fi

  case "$os" in
    ubuntu | debian | pop | mint)
      echo "Installing Debian/Ubuntu prerequisites..."
      sudo apt-get update
      sudo apt-get install -y ansible just git curl lua-language-server || true
      if ! command -v uv &>/dev/null; then
        echo "Installing uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
      fi
      if ! command -v selene &>/dev/null; then
        echo "Installing selene via cargo..."
        if command -v cargo &>/dev/null; then
          cargo install selene
        fi
      fi
      ;;
    arch | manjaro)
      echo "Installing Arch Linux prerequisites..."
      sudo pacman -Sy --needed --noconfirm ansible just git curl selene lua-language-server uv
      ;;
    *)
      echo "Unsupported OS: $os"
      echo "Please ensure ansible, just, git, curl, selene, lua-language-server, uv, and prek are installed manually."
      exit 1
      ;;
  esac

  if ! command -v prek &>/dev/null; then
    echo "Installing prek via uv..."
    local uv_path="uv"
    if ! command -v uv &>/dev/null; then
      if [ -f "$HOME/.local/bin/uv" ]; then
        uv_path="$HOME/.local/bin/uv"
      elif [ -f "$HOME/.cargo/bin/uv" ]; then
        uv_path="$HOME/.cargo/bin/uv"
      fi
    fi
    "$uv_path" tool install prek
  fi
}

install_collections() {
  if ! ansible-galaxy collection list community.general >/dev/null 2>&1; then
    echo "Installing community.general collection..."
    ansible-galaxy collection install community.general --ignore-certs
  fi

  if ! ansible-galaxy collection list kewlfft.aur >/dev/null 2>&1; then
    echo "Installing kewlfft.aur collection..."
    ansible-galaxy collection install kewlfft.aur --ignore-certs
  fi
}

run_playbook() {
  if [[ "$1" == "--no-playbook" ]] || [[ "$1" == "--only-prereqs" ]]; then
    echo "Skipping playbook execution."
    return 0
  fi
  if [[ "$1" == "--check" ]] || [[ "$1" == "dry-run" ]]; then
    echo "Running dry-run..."
    shift
    just dry-run "$@"
  else
    echo "Applying dotfiles configuration..."
    just apply "$@"
  fi
}

main() {
  local os
  os=$(detect_os)
  echo "Detected OS: $os"

  install_prereqs "$os"
  install_collections
  run_playbook "$@"
}

main "$@"
