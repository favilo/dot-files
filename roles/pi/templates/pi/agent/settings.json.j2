{% set base = {
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "packages": [
    "npm:pi-vim",
    {
      "source": "../../git/agents/bigpowers",
      "prompts": []
    },
    "../../git/agents/pi-extensions",
    "../../git/agents/pi-account-switcher",
    "npm:pi-antigravity",
    "npm:pi-wakatime",
    "npm:pi-anthropic-oauth",
    "npm:@billjr99/pi-openai-compat",
    "npm:pi-context",
    "npm:pi-effort",
    "npm:pi-obsidian",
    "../../git/agents/pi-cursor-sdk"
  ],
  "hideThinkingBlock": false
} -%}
{% if pi_existing_settings.content is defined -%}
  {% set existing = (pi_existing_settings.content | b64decode | from_json) -%}
  {% if existing.deviceId is defined -%}
    {% set _ = base.update({'deviceId': existing.deviceId}) -%}
  {% endif -%}
  {% if existing.defaultProvider is defined -%}
    {% set _ = base.update({'defaultProvider': existing.defaultProvider}) -%}
  {% endif -%}
  {% if existing.defaultModel is defined -%}
    {% set _ = base.update({'defaultModel': existing.defaultModel}) -%}
  {% endif -%}
{% endif -%}
{{ base | to_nice_json(indent=2) }}
