# vi: set ft=yaml :

dotfiles_user: "{{ lookup('env', 'USER') }}"
dotfiles_user_home: "{{ '~' | expanduser }}"
dotfiles_home: "{{dotfiles_user_home}}/git/dot-files"
xdg_config_home: "{{ lookup('env', 'XDG_CONFIG_HOME') | default(dotfiles_user_home ~ '/.config', true) }}"

full_name: Kevin Oberlies

# Git
git_user: favilo
git_email: favilo@gmail.com

git_signing_key: "{{ lookup('env', 'GIT_SIGNING_KEY_ID') }}"

# Live ~/.cargo/bin names that role-drift should not suggest encoding into Ansible.
# Ansible-declared crates remain the install baseline.
dotfiles_cargo_encode_blocklist:
  - taplo
  - vtracer
